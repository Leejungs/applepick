# Flask API + 크롤러 이미지 (crawler 서비스도 같은 이미지를 쓴다)
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY backend/requirements.txt .
RUN pip install -r requirements.txt

COPY backend/ .

EXPOSE 50000
CMD ["gunicorn", "-b", "0.0.0.0:50000", "--workers", "2", "--threads", "4", "--timeout", "300", "--access-logfile", "-", "app:application"]
